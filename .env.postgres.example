# Replace this value before deployment. URL-encode it if AGENT_EVAL_DATABASE_URL is set explicitly.
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_USER=agent_eval
POSTGRES_DB=agent_eval
AGENT_EVAL_BACKUP_PATH=/srv/agent-eval/backups
AGENT_EVAL_BACKUP_RETENTION_DAYS=14
AGENT_EVAL_BACKUP_UID=1000
AGENT_EVAL_BACKUP_GID=1000
AGENT_EVAL_DEPLOYMENT_OVERLAY=deploy/compose.production.yaml
# Optional full URL, useful for a managed PostgreSQL service.
# AGENT_EVAL_DATABASE_URL=postgresql+asyncpg://agent_eval:password@postgres:5432/agent_eval
AGENT_EVAL_DATABASE_POOL_SIZE=5
AGENT_EVAL_DATABASE_MAX_OVERFLOW=5
AGENT_EVAL_DATABASE_POOL_TIMEOUT_SECONDS=30
# Artifact objects remain filesystem-backed in this phase and must be shared by all workers.
AGENT_EVAL_ARTIFACT_BACKEND=local
AGENT_EVAL_ARTIFACT_LOCAL_DIR=/data/artifacts
# With PostgreSQL these are deployment-wide limits shared by every API/worker replica.
AGENT_EVAL_WORKER_AGENT_CONCURRENCY=10
AGENT_EVAL_DEEPSEEK_CONCURRENCY=5
AGENT_EVAL_CITATION_FETCH_CONCURRENCY=10
AGENT_EVAL_CITATION_DOMAIN_CONCURRENCY=2
AGENT_EVAL_RESOURCE_LEASE_SECONDS=30
AGENT_EVAL_RESOURCE_LEASE_POLL_SECONDS=0.1
WORKER_REPLICAS=2
