AGENT_EVAL_DATA_PATH=/srv/agent-eval/data
AGENT_EVAL_SECRETS_PATH=/etc/agent-eval/secrets
AGENT_EVAL_DATASET_PATH=/srv/agent-eval/demo-dataset
# Host path used only by the maintenance backup overlay. Replicate it off-host.
AGENT_EVAL_BACKUP_PATH=/srv/agent-eval/backups
AGENT_EVAL_BACKUP_RETENTION_DAYS=14
AGENT_EVAL_BACKUP_UID=1000
AGENT_EVAL_BACKUP_GID=1000
AGENT_EVAL_BACKUP_MAX_AGE_HOURS=26
AGENT_EVAL_DEPLOYMENT_OVERLAY=deploy/compose.production.yaml
AGENT_EVAL_READINESS_URL=http://127.0.0.1:8080/health/ready
# Host interface for published web port. Use 127.0.0.1 behind a reverse proxy,
# or a private LAN address such as 192.168.39.77 for internal-only access.
WEB_BIND=127.0.0.1
AGENT_EVAL_LOG_LEVEL=INFO
AGENT_EVAL_ARTIFACT_BACKEND=local
AGENT_EVAL_ARTIFACT_LOCAL_DIR=/data/artifacts
AGENT_EVAL_WORKER_AGENT_CONCURRENCY=10
AGENT_EVAL_WORKER_MAX_LOCAL_WORKSPACE_ATTEMPTS=2
AGENT_EVAL_DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
AGENT_EVAL_DEEPSEEK_MODEL=deepseek-v4-flash
AGENT_EVAL_DEEPSEEK_CONCURRENCY=5
AGENT_EVAL_CITATION_FETCH_CONCURRENCY=10
AGENT_EVAL_CITATION_DOMAIN_CONCURRENCY=2
AGENT_EVAL_RESOURCE_LEASE_SECONDS=30
AGENT_EVAL_RESOURCE_LEASE_POLL_SECONDS=0.1
# Operational-check bounds: workers 0..100, queued/failed/expired 0..10000,
# queue age 1..10080 minutes, window 1..720 hours, grace 0..86400 seconds.
AGENT_EVAL_MONITORING_EXPECTED_WORKERS=2
AGENT_EVAL_MONITORING_MAX_QUEUED_RUNS=10
AGENT_EVAL_MONITORING_MAX_QUEUE_AGE_MINUTES=30
AGENT_EVAL_MONITORING_WINDOW_HOURS=24
AGENT_EVAL_MONITORING_MAX_SYSTEM_FAILED_RUNS=0
AGENT_EVAL_MONITORING_RESOURCE_LEASE_GRACE_SECONDS=120
AGENT_EVAL_MONITORING_MAX_EXPIRED_RESOURCE_LEASES=0
AGENT_EVAL_MONITORING_MAX_QUEUED_WORKSPACE_ATTEMPTS=20
AGENT_EVAL_MONITORING_MAX_WORKSPACE_QUEUE_AGE_MINUTES=30
AGENT_EVAL_MONITORING_MAX_RECENT_FAILED_WORKSPACE_ATTEMPTS=10
WEB_PORT=8080
# Keep WEB_BIND and AGENT_EVAL_READINESS_URL on the same reachable address/port.
