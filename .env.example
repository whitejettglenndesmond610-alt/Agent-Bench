AGENT_EVAL_ENVIRONMENT=development
AGENT_EVAL_DATABASE_URL=sqlite+aiosqlite:////data/agent-eval.db
AGENT_EVAL_DATABASE_POOL_SIZE=5
AGENT_EVAL_DATABASE_MAX_OVERFLOW=5
AGENT_EVAL_DATABASE_POOL_TIMEOUT_SECONDS=30
AGENT_EVAL_DATA_DIR=/data
AGENT_EVAL_LOG_LEVEL=INFO
AGENT_EVAL_WORKER_POLL_SECONDS=2
AGENT_EVAL_WORKER_LEASE_SECONDS=30
AGENT_EVAL_WORKER_HEARTBEAT_SECONDS=10
AGENT_EVAL_WORKER_STALE_RUN_SECONDS=60
AGENT_EVAL_WORKER_MAX_ACTIVE_RUNS=3
AGENT_EVAL_WORKER_MAX_LOCAL_RUNS=3
AGENT_EVAL_WORKER_MAX_PROVIDER_RUNS=2
AGENT_EVAL_WORKER_MAX_LOCAL_WORKSPACE_ATTEMPTS=2
AGENT_EVAL_WORKER_AGENT_CONCURRENCY=10
AGENT_EVAL_RESOURCE_LEASE_SECONDS=30
AGENT_EVAL_RESOURCE_LEASE_POLL_SECONDS=0.1
AGENT_EVAL_ARTIFACT_BACKEND=local
AGENT_EVAL_ARTIFACT_LOCAL_DIR=/data/artifacts
# S3 credentials are discovered from the standard AWS SDK credential chain.
AGENT_EVAL_ARTIFACT_S3_BUCKET=
AGENT_EVAL_ARTIFACT_S3_PREFIX=
AGENT_EVAL_ARTIFACT_S3_ENDPOINT_URL=
AGENT_EVAL_ARTIFACT_S3_REGION=
AGENT_EVAL_ARTIFACT_S3_FORCE_PATH_STYLE=false
AGENT_EVAL_ARTIFACT_RETENTION_DAYS=30
AGENT_EVAL_DEEPSEEK_API_KEY=
AGENT_EVAL_DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
AGENT_EVAL_DEEPSEEK_MODEL=deepseek-chat
AGENT_EVAL_DEEPSEEK_TIMEOUT_SECONDS=60
AGENT_EVAL_DEEPSEEK_CONCURRENCY=5
AGENT_EVAL_CITATION_FETCH_CONCURRENCY=10
AGENT_EVAL_CITATION_DOMAIN_CONCURRENCY=2
AGENT_EVAL_CITATION_CONNECT_TIMEOUT_SECONDS=5
AGENT_EVAL_CITATION_READ_TIMEOUT_SECONDS=15
AGENT_EVAL_CITATION_MAX_REDIRECTS=3
AGENT_EVAL_CITATION_MAX_RESPONSE_BYTES=2097152
AGENT_EVAL_CITATION_MAX_TEXT_BYTES=204800
# Generate with: uv run python -m agent_eval.maintenance.main hash-password
AGENT_EVAL_READ_ONLY_PASSWORD_HASH=
AGENT_EVAL_OPERATOR_PASSWORD_HASH=
# Generate with: uv run python -m agent_eval.maintenance.main generate-encryption-key
AGENT_EVAL_ENCRYPTION_KEY=
WEB_PORT=8080
